# Copy to deploy/.env and fill in. Everything here is documented in docs/ENVIRONMENT.md.
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_MASTER_KEY=change-me-to-another-long-random-string
DATABASE_URL=postgresql+asyncpg://mantiq:mantiq@postgres:5432/mantiq
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=https://outreach.mantiq.example
CORS_ORIGINS=https://outreach.mantiq.example
OUTREACH_MODE=dry_run
SANDBOX_ALLOWLIST=
TZ_DEFAULT=Africa/Cairo
ALLOW_FAKE_PROVIDERS=false

# LLM (Anthropic or any OpenAI-compatible endpoint)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_DAILY_BUDGET_USD=5
LLM_PRICE_INPUT_PER_M=1
LLM_PRICE_OUTPUT_PER_M=3

# Discovery
SEARCH_PROVIDER=fake
SEARCH_API_KEY=
PLACES_API_KEY=
API_DAILY_BUDGET_USD=5
VERIFY_PROVIDER=local
VERIFY_API_KEY=

# Email
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=
DKIM_PRIVATE_KEY=
DKIM_SELECTOR=default
SENDING_DOMAIN=

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Staff notifications and public links
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL=
BOOKING_URL=
FEATURES_URL=
CALENDAR_PROVIDER=link

# Sender identity (required in live mode)
SENDER_NAME=
SENDER_TITLE=
SENDER_EMAIL=
COMPANY_NAME=Mantiq Technologies
COMPANY_ADDRESS=
COMPANY_PHONE=
POC_OFFER_TEXT_AR=
POC_OFFER_TEXT_EN=
DEMO_DURATION_MINUTES=

# Crawler
CRAWLER_USER_AGENT=MantiqOutreachBot/1.0
CRAWLER_BOT_URL=
CRAWL_MAX_PAGES=6
CRAWL_DELAY_SECONDS=1
CRAWL_TIMEOUT_SECONDS=10
CRAWL_ALLOW_LOCAL_HOSTS=false

# Flags
CLICK_TRACKING_ENABLED=false
OPEN_TRACKING_ENABLED=false
LOG_LLM_PAYLOADS=false
CELERY_TASK_ALWAYS_EAGER=false

# Retention
RETENTION_DAYS_PAGE_TEXT=180
RETENTION_DAYS_CLOSED_CONTACTS=365
RETENTION_DAYS_MESSAGES=2555

# Session and login policy
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
UNSUBSCRIBE_TOKEN_TTL_DAYS=90

# LLM / crawler tuning
LLM_TIMEOUT_SECONDS=45
CRAWL_MAX_PAGE_BYTES=2000000
CRAWL_RECRAWL_AFTER_DAYS=30

# WhatsApp Cloud API base
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
APP_NAME=Mantiq Outreach
